---
import { Icon } from 'astro-icon/components'
import { docsNav } from '../lib/nav'

const current = Astro.url.pathname.replace(/\/$/, '') || '/'
---

<div
  id="sidebar-backdrop"
  class="fixed inset-0 z-40 invisible bg-ink/30 opacity-0 transition-[opacity,visibility] duration-200 lg:hidden"
  aria-hidden="true"
>
</div>

<aside
  id="docs-sidebar"
  class="scroll-slim fixed inset-y-0 left-0 z-50 w-[17rem] -translate-x-full overflow-y-auto border-r border-line bg-canvas pt-6 pb-10 transition-transform duration-200 ease-out lg:sticky lg:top-16 lg:z-40 lg:h-[calc(100dvh-4rem)] lg:w-[16.5rem] lg:shrink-0 lg:translate-x-0"
>
  <nav aria-label="文档导航" class="px-4">
    {
      docsNav.map((group) => (
        <div class="mb-6">
          <h2 class="label-mono mb-2 px-2">{group.title}</h2>
          <ul>
            {group.items.map((item) => {
              const active = current === item.href
              return (
                <li>
                  <a
                    href={item.href}
                    aria-current={active ? 'page' : undefined}
                    class:list={[
                      'relative block rounded-[5px] py-[6px] pr-2 pl-[calc(0.5rem+2px)] text-[13.5px] transition-colors',
                      active
                        ? 'bg-accent-soft font-medium text-on-accent-soft'
                        : 'text-ink-muted hover:bg-canvas-subtle hover:text-ink',
                    ]}
                  >
                    {active && (
                      <span
                        aria-hidden="true"
                        class="absolute top-[6px] bottom-[6px] left-0 w-[2px] rounded-full bg-accent"
                      />
                    )}
                    {item.title}
                  </a>
                </li>
              )
            })}
          </ul>
        </div>
      ))
    }

    <div class="mt-8 border-t border-line pt-4">
      <a
        href="https://github.com/remorses/gpuix"
        target="_blank"
        rel="noreferrer noopener"
        class="flex items-center gap-2 rounded-[5px] px-2 py-1.5 text-[13px] text-ink-muted transition-colors hover:bg-canvas-subtle hover:text-ink"
      >
        <Icon name="ph:github-logo" class="size-4 shrink-0" />
        GPUIX 仓库
      </a>
      <a
        href="https://github.com/remorses/gpuix/blob/main/LICENSE"
        target="_blank"
        rel="noreferrer noopener"
        class="flex items-center gap-2 rounded-[5px] px-2 py-1.5 text-[13px] text-ink-muted transition-colors hover:bg-canvas-subtle hover:text-ink"
      >
        <Icon name="ph:file-text" class="size-4 shrink-0" />
        Apache-2.0 许可
      </a>
      <p class="mt-3 px-2 text-[11.5px] leading-relaxed text-ink-faint">
        内容整理自 GPUIX 官方 README，示例与 API 以英文原文为准。
      </p>
    </div>
  </nav>
</aside>
