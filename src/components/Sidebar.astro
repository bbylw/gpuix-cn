---
import { Icon } from 'astro-icon/components'
import NavGroups from './NavGroups.astro'
import { docsNav } from '../lib/nav'
import { GITHUB_URL, LICENSE_URL } from '../lib/site'

const docCount = docsNav.reduce((n, group) => n + group.items.length, 0)
---

<div
  id="sidebar-backdrop"
  class="fixed inset-0 z-40 invisible bg-ink/30 opacity-0 transition-[opacity,visibility] duration-200 lg:hidden"
>
</div>

<aside
  id="docs-sidebar"
  class="scroll-slim fixed inset-y-0 left-0 z-50 w-[17rem] -translate-x-full overflow-y-auto border-r border-line bg-canvas pt-6 pb-10 transition-transform duration-200 ease-out lg:sticky lg:z-40 lg:w-[16.5rem] lg:shrink-0 lg:translate-x-0"
  style="top: var(--header-h); height: calc(100dvh - var(--header-h))"
>
  <nav aria-label="文档导航" class="px-4">
    <NavGroups variant="sidebar" />

    <div class="mt-8 border-t border-line pt-4">
      <p class="label-mono mb-2 px-2">{docCount} 篇文档 · 中文</p>
      <a
        href={GITHUB_URL}
        target="_blank"
        rel="noreferrer noopener"
        class="flex items-center gap-2 rounded-card px-2 py-1.5 text-[13px] text-ink-muted transition-colors hover:bg-canvas-subtle hover:text-ink"
      >
        <Icon name="ph:github-logo" class="size-4 shrink-0" />
        GPUIX 仓库
      </a>
      <a
        href={LICENSE_URL}
        target="_blank"
        rel="noreferrer noopener"
        class="flex items-center gap-2 rounded-card px-2 py-1.5 text-[13px] text-ink-muted transition-colors hover:bg-canvas-subtle hover:text-ink"
      >
        <Icon name="ph:file-text" class="size-4 shrink-0" />
        Apache-2.0 许可
      </a>
      <p class="mt-3 px-2 text-[11.5px] leading-relaxed text-ink-faint">
        内容整理自 GPUIX 官方 README，示例与 API 以英文原文为准。
      </p>
    </div>
  </nav>
</aside>
