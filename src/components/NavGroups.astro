---
import { docsNav, type NavGroup } from '../lib/nav'

interface Props {
  /** sidebar = 带当前项高亮的竖排导航；columns = 紧凑多列索引；inline = 首页那种带箭头提示的索引 */
  variant: 'sidebar' | 'columns' | 'inline'
  groups?: NavGroup[]
}

const { variant, groups = docsNav } = Astro.props

const current = Astro.url.pathname.replace(/\/$/, '') || '/'

const shell: Record<Props['variant'], { list: string; item: string }> = {
  sidebar: { list: '', item: '' },
  columns: { list: '', item: 'block py-[5px] text-[13.5px] text-ink-muted hover:text-ink' },
  inline: { list: '', item: '' },
}
---

{
  groups.map((group) => (
    <div class="mb-9 break-inside-avoid">
      {/* 分组名是导航的视觉标签，不属于文档大纲。用 p 而非 h2：
          在文档页上 h1 出现在侧边栏之后，h2 先于 h1 会打乱标题层级。 */}
      <p class:list={['label-mono', variant === 'sidebar' ? 'mb-2 px-2' : 'mb-2.5']}>
        {group.title}
        {variant === 'inline' && (
          <span class="text-ink-faint"> · {group.items.length} 篇</span>
        )}
      </p>
      <ul class={shell[variant].list}>
        {group.items.map((item) => {
          const active = current === item.href
          return (
            <li>
              {variant === 'sidebar' ? (
                <a
                  href={item.href}
                  aria-current={active ? 'page' : undefined}
                  class:list={[
                    'relative block rounded-card py-[6px] pr-2 pl-[calc(0.5rem+2px)] text-[13.5px] transition-colors',
                    active
                      ? 'bg-accent-soft font-medium text-on-accent-soft'
                      : 'text-ink-muted hover:bg-canvas-subtle hover:text-ink',
                  ]}
                >
                  {active && (
                    <span
                      aria-hidden="true"
                      class="absolute top-[6px] bottom-[6px] left-0 w-[2px] rounded-full bg-accent"
                    />
                  )}
                  {item.title}
                </a>
              ) : variant === 'inline' ? (
                <a
                  href={item.href}
                  class="group flex items-baseline gap-2 py-[5px] text-[13.5px] text-ink-muted transition-colors hover:text-ink"
                >
                  <span class="flex-1">{item.title}</span>
                  <svg
                    class="size-3 shrink-0 opacity-0 transition-opacity group-hover:opacity-100"
                    viewBox="0 0 256 256"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path d="M221.7 133.7l-96 96a24 24 0 0 1-34-34l79-79-79-79a24 24 0 0 1 34-34l96 96a24 24 0 0 1 0 34Z" />
                  </svg>
                </a>
              ) : (
                <a href={item.href} class={shell[variant].item}>
                  {item.title}
                </a>
              )}
            </li>
          )
        })}
      </ul>
    </div>
  ))
}
