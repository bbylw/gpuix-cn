---
import type { MarkdownHeading } from 'astro'

interface Props {
  headings: MarkdownHeading[]
}

const { headings } = Astro.props

// 只展示 h2 / h3，h4 以下会让目录过长
const items = headings.filter((h) => h.depth === 2 || h.depth === 3)
---

{
  items.length > 0 && (
    <nav aria-label="本页目录" class="text-[13px]">
      {/* 分组名是导航标签，不进文档大纲，因此用 p 而不是 h2 */}
      <p class="label-mono mb-2.5 pl-3.5">本页内容</p>
      <ul class="border-l border-line" data-toc>
        {items.map((heading) => (
          <li>
            <a
              href={`#${heading.slug}`}
              data-toc-link={heading.slug}
              class:list={[
                'block border-l-2 py-[5px] leading-snug transition-colors -ml-px',
                heading.depth === 3 ? 'pl-7' : 'pl-3.5',
                'border-transparent text-ink-muted hover:border-line-strong hover:text-ink',
                'aria-[current=true]:border-accent aria-[current=true]:text-ink aria-[current=true]:font-medium',
              ]}
            >
              {heading.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

<script>
  /**
   * 目录高亮。
   *
   * 让位距离从 CSS 变量 --header-offset 读，而不是在 JS 里另写一个数字：
   * 顶栏高度在 global.css 里改一处，这里自动跟上。
   */
  function offsetPx(): number {
    const raw = getComputedStyle(document.documentElement).getPropertyValue('--header-offset')
    const value = Number.parseFloat(raw)
    if (Number.isFinite(value)) {
      // rem 需要换算成 px；写成 px 时直接返回
      return raw.trim().endsWith('rem') ? value * 16 : value
    }
    // 读不到就退回顶栏高度，宁可高亮偏早也不要整块失效
    return document.querySelector('header')?.getBoundingClientRect().height ?? 0
  }

  function markActive(links: Map<string, HTMLAnchorElement>, offset: number) {
    let current: string | null = null
    for (const slug of links.keys()) {
      const el = document.getElementById(slug)
      if (!el) continue
      if (el.getBoundingClientRect().top <= offset) current = slug
      else break
    }
    for (const [slug, link] of links) {
      if (slug === current) link.setAttribute('aria-current', 'true')
      else link.removeAttribute('aria-current')
    }
  }

  let observer: IntersectionObserver | null = null

  function initToc() {
    // 上一次可能留下了 observer，先断开再重建，避免观察目标越积越多
    observer?.disconnect()
    observer = null

    const links = new Map(
      [...document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')].map((a) => [
        a.dataset.tocLink!,
        a,
      ]),
    )
    if (links.size === 0) return

    const headings = [...links.keys()]
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => el !== null)

    const visible = new Set<string>()
    const offset = offsetPx()

    observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) visible.add(entry.target.id)
          else visible.delete(entry.target.id)
        }
        if (visible.size > 0) {
          const first = headings.find((h) => visible.has(h.id))
          if (first) {
            for (const [slug, link] of links) {
              if (slug === first.id) link.setAttribute('aria-current', 'true')
              else link.removeAttribute('aria-current')
            }
            return
          }
        }
        markActive(links, offset)
      },
      { rootMargin: `-${offset}px 0px -70% 0px`, threshold: [0, 1] },
    )

    headings.forEach((h) => observer?.observe(h))
    markActive(links, offset)
  }

  initToc()

  // 视口高度变化会改变「哪一节在视口内」的判定
  window.addEventListener('resize', initToc, { passive: true })
</script>
