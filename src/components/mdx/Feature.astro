---
/** 实现状态清单中的一项。 */
import { Icon } from 'astro-icon/components'

interface Props {
  done?: boolean
}

const { done = false } = Astro.props
---

<li class="flex list-none items-start gap-2 !mt-2">
  <Icon
    name={done ? 'ph:check-circle-fill' : 'ph:circle-dashed'}
    class:list={['mt-[0.2rem] size-[15px] shrink-0', done ? 'text-green' : 'text-line-strong']}
    aria-hidden="true"
  />
  <span class:list={['min-w-0', done ? 'text-ink-soft' : 'text-ink-faint']}>
    <slot />
  </span>
</li>
