---
import Base from '../layouts/Base.astro'
import Header from '../components/Header.astro'
import CodeEnhance from '../components/CodeEnhance.astro'
import NavGroups from '../components/NavGroups.astro'
import CalloutBox from '../components/CalloutBox.astro'
import { Icon } from 'astro-icon/components'
import { Code } from 'astro:components'
import { Image } from 'astro:assets'
import surface from '../assets/framebuffer-surface.png'
import { docsNav } from '../lib/nav'
import { codeThemes } from '../lib/shiki'
import { GITHUB_URL, LICENSE_URL, GPUI_URL, QUICK_START_HREF } from '../lib/site'

// 首页的 <Code> 不会自动继承 markdown.shikiConfig，必须显式给同一份主题
const shiki = { themes: codeThemes, defaultColor: false as const }

const heroCode = `import { useState } from 'react'
import { render } from '@gpuix/react'

function App() {
  const [count, setCount] = useState(0)

  return (
    <div style={{ padding: 24, height: '100%' }}>
      <div
        onClick={() => setCount((c) => c + 1)}
        style={{
          padding: 12,
          borderRadius: 8,
          backgroundColor: '#232323',
        }}
      >
        <text style={{ color: '#e2e2e2' }}>
          Count: {count}
        </text>
      </div>
    </div>
  )
}

render(<App />, { width: 800, height: 600 })`

const installSteps = [
  { verb: '创建', cmd: 'bunx @gpuix/cli new my-app', note: '下载官方示例应用并装好依赖' },
  { verb: '进入', cmd: 'cd my-app', note: '一个文件的应用：app.tsx' },
  { verb: '运行', cmd: 'bun run dev', note: '保存即在同一个窗口里重挂载' },
]

const pipeline = [
  { stage: '组件树', body: '你写的 JSX 与 useState，标准 React 或 Solid。' },
  { stage: 'GPUI 元素', body: '布局、文本测量、命中测试全部在 Rust 侧完成。' },
  { stage: '渲染后端', body: 'Metal、DirectX 或 Vulkan，按平台选一个。' },
  { stage: '屏幕像素', body: '没有 DOM，没有 WebView，没有转译层。' },
]

const metrics = [
  { value: '3', label: '桌面渲染后端' },
  { value: '0', label: 'WebView' },
  { value: '82 MB', label: 'Bun 版 .app' },
]
---

<Base
  title="GPUIX：用 React 或 Solid 编写 GPU 原生桌面界面"
  description="用 TypeScript 编写 React 或 Solid 组件树，GPUIX 使用 Metal、DirectX 或 Vulkan 将其绘制出来。没有 Electron，也没有 WebView。"
>
  <Header />

  <main id="main">
    <!-- ============ 首屏：非对称分栏 ============ -->
    <section class="border-b border-line">
      <div
        class="mx-auto grid max-w-[78rem] items-center gap-12 px-5 pt-14 pb-16 sm:px-8 lg:grid-cols-[1fr_minmax(0,27rem)] lg:gap-16 lg:pt-20 lg:pb-20"
      >
        <div>
          <p class="rise rise-1 mb-5">
            <span
              class="inline-flex items-center gap-2 rounded-full border border-line bg-canvas-subtle py-1 pr-3.5 pl-2.5 font-mono text-[11px] tracking-wide text-ink-muted"
            >
              <span aria-hidden="true" class="size-1.5 rounded-full bg-accent"></span>
              中文文档 · React / Solid → GPU
            </span>
          </p>
          <h1
            class="rise rise-2 text-[length:var(--text-hero)] leading-[1.1] font-semibold tracking-[-0.032em] text-balance text-ink"
          >
            React 的写法，<br class="hidden sm:block" />GPU 的渲染管线
          </h1>
          <p class="rise rise-3 mt-5 max-w-[44ch] text-lg leading-relaxed text-pretty text-ink-muted">
            用 TypeScript 写 React 或 Solid 组件树，GPUIX 把它交给 GPUI，由 Metal、DirectX 或
            Vulkan 直接画出来。没有 Electron，也没有 WebView。
          </p>
          <div class="rise rise-4 mt-9 flex flex-wrap items-center gap-3">
            <a
              href={QUICK_START_HREF}
              class="inline-flex h-11 items-center gap-2 rounded-card bg-accent px-5 text-sm font-medium text-accent-ink transition-colors hover:bg-accent-hover active:translate-y-[1px]"
            >
              开始使用
              <Icon name="ph:arrow-right-bold" class="size-4" aria-hidden="true" />
            </a>
            <a
              href="/docs/architecture"
              class="inline-flex h-11 items-center rounded-card border border-line-strong px-5 text-sm font-medium text-ink transition-colors hover:bg-surface active:translate-y-[1px]"
            >
              看它怎么工作
            </a>
          </div>
        </div>

        <div class="rise rise-3 min-w-0">
          <div class="code-frame shadow-lift">
            <div class="code-toolbar">
              <span class="code-lang">app.tsx</span>
              <span class="label-mono">一个文件的全部</span>
            </div>
            <Code
              code={heroCode}
              lang="tsx"
              themes={shiki.themes}
              defaultColor={shiki.defaultColor}
              class="scroll-slim overflow-auto px-4 py-3.5 text-[12.5px]"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- ============ 管线：横向轨 ============ -->
    <section class="border-b border-line py-16 sm:py-20">
      <div class="reveal mx-auto max-w-[78rem] px-5 sm:px-8">
        <h2
          class="text-[length:var(--text-title)] leading-tight font-semibold tracking-[-0.022em] text-balance text-ink"
        >
          从组件树到像素，中间没有浏览器
        </h2>
        <p class="mt-3 max-w-[58ch] text-pretty leading-relaxed text-ink-muted">
          <a
              href={GPUI_URL}
            target="_blank"
            rel="noreferrer noopener"
            class="underline decoration-line-strong underline-offset-4 transition-colors hover:text-ink"
            >GPUI</a
          >{" "}
          是 Zed 编辑器用来绘制自己的那套 GPU UI 框架。GPUIX 把 JSX 接到它的元素协议上，所以
          <code class="rounded-chip bg-surface px-1.5 py-0.5 font-mono text-[0.85em]">hover</code>
          之类的样式写在 Rust 里，而不是 CSS 里。
        </p>

        <ol class="mt-10 grid border-t border-line sm:grid-cols-2 lg:grid-cols-4">
          {
            pipeline.map((step, i) => (
              <li class="border-b border-line px-0 py-5 sm:px-6 sm:first:pl-0 sm:last:pr-0">
                <div class="flex items-center gap-3">
                  <span class="font-mono text-[11px] tracking-widest text-ink-faint">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <span
                    aria-hidden="true"
                    class:list={[
                      'block h-[2px] flex-1',
                      i === pipeline.length - 1 ? 'bg-accent' : 'bg-line',
                    ]}
                  />
                </div>
                <h3 class="mt-3.5 text-[0.9375rem] font-semibold text-ink">{step.stage}</h3>
                <p class="mt-1 text-[13.5px] leading-relaxed text-pretty text-ink-muted">
                  {step.body}
                </p>
              </li>
            ))
          }
        </ol>

        <dl class="mt-8 flex flex-wrap items-baseline gap-x-10 gap-y-3">
          {
            metrics.map((metric) => (
              <div class="flex items-baseline gap-2.5">
                <dd class="font-mono text-[1.65rem] leading-none font-semibold tracking-[-0.02em] text-ink">
                  {metric.value}
                </dd>
                <dt class="label-mono">{metric.label}</dt>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <!-- ============ 能力：非等分 bento ============ -->
    <section class="border-b border-line py-16 sm:py-20">
      <div class="reveal mx-auto max-w-[78rem] px-5 sm:px-8">
        <h2
          class="text-[length:var(--text-title)] leading-tight font-semibold tracking-[-0.022em] text-balance text-ink"
        >
          它替你做了什么
        </h2>

        <div class="mt-10 grid gap-4 lg:grid-cols-6">
          <!-- A：大图块 -->
          <div class="relative min-h-[19rem] overflow-hidden rounded-card bg-canvas shadow-lift lg:col-span-4 lg:row-span-2">
            <Image
              src={surface}
              alt=""
              width={1280}
              height={1024}
              class="absolute inset-0 size-full object-cover"
            />
            {/* 图片本身是深色帧缓冲，文字必须压在深底上才读得出来，
                因此遮罩用 on-media-scrim 而不是随主题翻转的 canvas。
                底部实色起步，保证浅色模式下也有足够对比度。 */}
            <div
              class="absolute inset-0 bg-linear-to-t from-on-media-scrim via-on-media-scrim/60 to-transparent"
              aria-hidden="true"
            >
            </div>
            <div class="relative flex h-full flex-col justify-end p-6 sm:p-8">
              <h3 class="text-xl font-semibold tracking-[-0.015em] text-on-media">
                真正的 GPU 渲染
              </h3>
              <p class="mt-2 max-w-[38ch] text-[14.5px] leading-relaxed text-pretty text-on-media-muted">
                组件树直接变成 GPUI 元素，由 Metal、DirectX 或 Vulkan 提交到屏幕。裁剪、合成、
                文本光栅化都在原生侧，DOM 一次都不参与。
              </p>
              <p class="label-mono mt-4">
                <a
                  href="/docs/architecture"
                  class="inline-flex items-center gap-1.5 text-on-media-accent transition-opacity hover:opacity-80"
                >
                  读架构说明
                  <Icon name="ph:caret-right-bold" class="size-3.5" aria-hidden="true" />
                </a>
              </p>
            </div>
          </div>

          <!-- B -->
          <div class="rounded-card border border-line bg-canvas-subtle p-6 lg:col-span-2">
            <h3 class="text-[0.9375rem] font-semibold text-ink">原生动画</h3>
            <p class="mt-2 text-[14px] leading-relaxed text-pretty text-ink-muted">
              React 只发一次目标值，Rust 计算中间帧并自己请求刷新。每一帧都不触发一次 React
              渲染，也不走 N-API。
            </p>
            <svg
              viewBox="0 0 200 96"
              class="mt-5 w-full"
              role="img"
              aria-label="缓动曲线：目标值下发一次，中间帧逐帧算出"
            >
              <g stroke="currentColor" class="text-line" stroke-width="1">
                <line x1="0" y1="24" x2="200" y2="24" stroke-dasharray="3 4"></line>
                <line x1="0" y1="48" x2="200" y2="48" stroke-dasharray="3 4"></line>
                <line x1="0" y1="72" x2="200" y2="72" stroke-dasharray="3 4"></line>
              </g>
              <path
                d="M4 88 C 60 88, 72 8, 196 8"
                fill="none"
                stroke="currentColor"
                class="text-accent"
                stroke-width="2"
                stroke-linecap="round"
              />
              <circle cx="4" cy="88" r="3" fill="currentColor" class="text-line-strong"></circle>
              <circle cx="196" cy="8" r="3.5" fill="currentColor" class="text-accent"></circle>
              <text x="186" y="92" font-size="9" font-family="var(--font-mono)" fill="currentColor" class="text-ink-faint">t</text>
              <text x="2" y="14" font-size="9" font-family="var(--font-mono)" fill="currentColor" class="text-ink-faint">v</text>
            </svg>
          </div>

          <!-- C -->
          <div class="rounded-card border border-line bg-canvas-subtle p-6 lg:col-span-2">
            <h3 class="text-[0.9375rem] font-semibold text-ink">React 与 Solid 皆可</h3>
            <p class="mt-2 text-[14px] leading-relaxed text-pretty text-ink-muted">
              两套运行时，同一套元素协议。
            </p>
            <ul class="mt-4 space-y-2">
              {
                [
                  { pkg: '@gpuix/react', note: 'React 运行时' },
                  { pkg: '@gpuix/solid', note: 'Solid 运行时' },
                ].map((row) => (
                  <li class="flex items-center gap-2 rounded-chip border border-line bg-canvas px-2.5 py-1.5">
                    <span aria-hidden="true" class="font-mono text-[12px] text-accent">›</span>
                    <span class="font-mono text-[12.5px] text-ink">{row.pkg}</span>
                    <span class="label-mono ml-auto">{row.note}</span>
                  </li>
                ))
              }
            </ul>
          </div>

          <!-- D -->
          <div class="rounded-card border border-line bg-canvas-subtle p-6 lg:col-span-3">
            <h3 class="text-[0.9375rem] font-semibold text-ink">虚拟列表</h3>
            <p class="mt-2 text-[14px] leading-relaxed text-pretty text-ink-muted">
              React 与 Rust 保留全部行，GPUI 只构建靠近视口的那几行。行高可以各不相同，你不必先声明。
            </p>
            <div class="mt-5 flex items-start gap-2" role="img" aria-label="只有视口内的两行被真正构建">
              <span class="flex-1">
                <span class="block space-y-1">
                  <span class="block h-1.5 rounded-chip border border-line"></span>
                  <span class="block h-1.5 rounded-chip border border-line"></span>
                </span>
                <span class="label-mono mt-1.5 block text-center">屏外</span>
              </span>
              <span class="flex-1">
                <span class="block space-y-1 rounded-chip border border-accent/50 p-1">
                  <span class="block h-1.5 rounded-chip bg-accent"></span>
                  <span class="block h-1.5 rounded-chip bg-accent"></span>
                </span>
                <span class="label-mono mt-1.5 block text-center text-accent">视口</span>
              </span>
              <span class="flex-1">
                <span class="block space-y-1">
                  <span class="block h-1.5 rounded-chip border border-line"></span>
                  <span class="block h-1.5 rounded-chip border border-line"></span>
                </span>
                <span class="label-mono mt-1.5 block text-center">屏外</span>
              </span>
            </div>
            <p class="label-mono mt-2">实心 = 视口内，真正被构建并绘制的行</p>
          </div>

          <!-- E -->
          <div class="rounded-card border border-line bg-canvas-subtle p-6 lg:col-span-3">
            <h3 class="text-[0.9375rem] font-semibold text-ink">可选中的原生文本</h3>
            <p class="mt-2 text-[14px] leading-relaxed text-pretty text-ink-muted">
              文本由 GPUI 排版，因此可以跨元素选中、复制，带语法高亮，也能做搜索高亮。
            </p>
            <div class="code-frame mt-4">
              <Code
                code={`<markdown>{doc}</markdown>
<code lang="rust">{src}</code>
<diff patch={patch} />`}
                lang="tsx"
                themes={shiki.themes}
                defaultColor={shiki.defaultColor}
                class="overflow-x-auto px-3.5 py-3 text-[12.5px]"
              />
            </div>
          </div>

          <!-- F -->
          <div class="rounded-card border border-line bg-canvas-subtle p-6 lg:col-span-6">
            <div class="grid gap-6 lg:grid-cols-[minmax(0,26rem)_minmax(0,1fr)] lg:items-center">
              <div>
                <h3 class="text-[0.9375rem] font-semibold text-ink">像 Playwright 一样测试</h3>
                <p class="mt-2 text-[14px] leading-relaxed text-pretty text-ink-muted">
                  用 testId 标记元素再驱动它们。鼠标走真实的 GPUI 输入路径，截图读取的是 GPU
                  表面，不是 DOM 快照。
                </p>
              </div>
              <div class="code-frame">
                <Code
                  code={`const button = await driver.query({ testId: 'increment' })
await button.click()
expect(await driver.screenshot()).toMatchFile('counter.png')`}
                  lang="ts"
                  themes={shiki.themes}
                  defaultColor={shiki.defaultColor}
                  class="overflow-x-auto px-3.5 py-3 text-[12.5px]"
                />
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ 安装：动词轨 ============ -->
    <section class="border-b border-line py-16 sm:py-20">
      <div class="reveal mx-auto grid max-w-[78rem] gap-12 px-5 sm:px-8 lg:grid-cols-[minmax(0,34rem)_minmax(0,1fr)] lg:gap-20">
        <div>
          <h2
            class="text-[length:var(--text-title)] leading-tight font-semibold tracking-[-0.022em] text-balance text-ink"
          >
            三条命令，一个窗口
          </h2>
          <p class="mt-3 text-pretty leading-relaxed text-ink-muted">
            无需克隆仓库，无需原生构建，也不需要装 Rust 工具链。
          </p>

          <ol class="mt-8">
            {
              installSteps.map((step, i) => (
                <li class="grid grid-cols-[4.5rem_minmax(0,1fr)] items-baseline gap-3 border-t border-line py-4">
                  <span class="label-mono">
                    <span class="text-ink-faint">{String(i + 1).padStart(2, '0')}</span>
                    {' · '}
                    {step.verb}
                  </span>
                  <code class="overflow-x-auto font-mono text-[13.5px] whitespace-nowrap text-ink"
                    >{step.cmd}</code
                  >
                  <span class="col-start-2 text-[13px] text-ink-muted">{step.note}</span>
                </li>
              ))
            }
          </ol>
          <p class="label-mono mt-6">macOS · Windows · Linux —— 同一套元素协议，三个桌面平台</p>
        </div>

        <CalloutBox>
          <p slot="label" class="mb-1 text-[12px] font-semibold text-accent">最容易踩的坑</p>
          <p class="text-[14.5px] leading-relaxed text-pretty text-ink-soft">
            给每一处 <code class="rounded-chip border border-line bg-surface px-1.5 py-0.5 font-mono text-[0.85em]">&lt;text&gt;</code>
            都设置 color。GPUI 不从父元素继承 color，没有颜色的文本会被画成黑色，在深色表面上直接消失。
          </p>
          <a
            href="/docs/elements"
            class="mt-3 inline-flex items-center gap-1.5 text-[13.5px] font-medium text-accent transition-opacity hover:opacity-80"
          >
            查看全部宿主元素
            <Icon name="ph:caret-right-bold" class="size-3.5" aria-hidden="true" />
          </a>
        </CalloutBox>
      </div>
    </section>

    <!-- ============ 文档索引：目录页 ============ -->
    <section class="py-16 sm:py-20">
      <div class="reveal mx-auto max-w-[78rem] px-5 sm:px-8">
        <div class="flex flex-wrap items-end justify-between gap-x-8 gap-y-3">
          <h2
            class="text-[length:var(--text-title)] leading-tight font-semibold tracking-[-0.022em] text-balance text-ink"
          >
            全部文档
          </h2>
          <p class="label-mono">
            {docsNav.reduce((n, group) => n + group.items.length, 0)} 篇 · 按
            {docsNav.length} 组组织 · 按 <kbd class="rounded-chip border border-line bg-surface px-1.5 py-0.5">⌘K</kbd>
            搜任何 API 名称
          </p>
        </div>

        <div class="mt-10 columns-1 gap-x-14 sm:columns-2 lg:columns-4">
          <NavGroups variant="inline" />
        </div>
      </div>
    </section>
  </main>

  <footer class="border-t border-line">
    <div class="mx-auto max-w-[78rem] px-5 pt-12 pb-8 sm:px-8">
      <div class="flex flex-col gap-8 sm:flex-row sm:items-start sm:justify-between">
        <div>
          <p class="flex items-center gap-2.5">
            <span
              aria-hidden="true"
              class="grid size-6 place-items-center rounded-card bg-accent font-mono text-[13px] leading-none font-bold text-accent-ink"
              >G</span
            >
            <span class="text-[0.9375rem] leading-none font-semibold tracking-[-0.01em] text-ink"
              >GPUIX</span
            >
          </p>
          <p class="mt-3 max-w-[36ch] text-[13.5px] leading-relaxed text-ink-faint">
            GPU 原生的桌面 UI，中文文档。内容整理自官方 README，示例与 API 以英文原文为准。
          </p>
        </div>
        <nav aria-label="页脚" class="flex items-center gap-6 text-sm text-ink-muted">
          <a href={QUICK_START_HREF} class="transition-colors hover:text-ink">快速开始</a>
          <a href="/docs/roadmap" class="transition-colors hover:text-ink">实现状态</a>
          <a
            href={GITHUB_URL}
            target="_blank"
            rel="noreferrer noopener"
            class="inline-flex items-center gap-1.5 transition-colors hover:text-ink"
          >
            GitHub
            <Icon name="ph:arrow-up-right-bold" class="size-3.5" aria-hidden="true" />
          </a>
        </nav>
      </div>
      <div
        class="mt-10 flex flex-col gap-2 border-t border-line pt-6 text-[13px] text-ink-faint sm:flex-row sm:items-center sm:justify-between"
      >
        <p>
          {docsNav.reduce((n, group) => n + group.items.length, 0)} 篇文档 ·
          <a
            href={LICENSE_URL}
            target="_blank"
            rel="noreferrer noopener"
            class="underline decoration-line underline-offset-4 transition-colors hover:text-accent"
            >Apache-2.0</a
          >
        </p>
        <p class="label-mono">React / Solid → Metal / DirectX / Vulkan</p>
      </div>
    </div>
  </footer>

  <CodeEnhance />
</Base>
