---
import Base from '../layouts/Base.astro'
import Header from '../components/Header.astro'
import NavGroups from '../components/NavGroups.astro'
import { QUICK_START_HREF } from '../lib/site'
---

<Base title="404：页面不存在" description="这个地址下没有内容，从文档索引里继续找。">
  <Header />
  <main id="main" class="mx-auto max-w-[104rem] px-4 py-16 sm:px-6 lg:py-24">
    <div class="max-w-[44rem]">
      <p class="font-mono text-[13px] text-accent">404</p>
      <h1 class="mt-3 text-[2.05rem] leading-[1.2] font-semibold tracking-[-0.022em] text-ink">
        页面不存在
      </h1>
      <p class="mt-4 text-pretty leading-relaxed text-ink-muted">
        这个地址下没有内容。它可能已经被移动，或者链接里有个拼写错误。
      </p>

      <div class="mt-9 flex flex-wrap gap-3">
        <a
          href="/"
          class="inline-flex h-10 items-center rounded-card bg-accent px-4 text-sm font-medium text-accent-ink transition-colors hover:bg-accent-hover active:translate-y-[1px]"
        >
          回到首页
        </a>
        <a
          href={QUICK_START_HREF}
          class="inline-flex h-10 items-center rounded-card border border-line-strong px-4 text-sm font-medium text-ink transition-colors hover:bg-surface active:translate-y-[1px]"
        >
          快速开始
        </a>
      </div>
    </div>

    <nav
      aria-label="文档导航"
      class="mt-16 grid gap-x-14 gap-y-9 border-t border-line pt-10 sm:grid-cols-2 lg:grid-cols-4"
    >
      <NavGroups variant="columns" />
    </nav>
  </main>
</Base>
